/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eleventy-explorer",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-10",

  "routes": [{ "pattern": "eleventy-explorer.tigersway.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },

  "triggers": { "crons": ["0 20 * * sun", "0 */2 * * *"] }, // Every Sunday at 20:00 UTC = Monday 03:00 in Bangkok

  "secrets": { "required": ["CF_DEPLOY_HOOK_URL", "GH_ACCESS_TOKEN"] },

  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },

  "placement": { "mode": "smart" }
}
